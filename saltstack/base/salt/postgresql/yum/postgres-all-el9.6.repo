[pgdgcommon-96]
name=PostgreSQL Common (Archived)
baseurl=https://yum-archive.postgresql.org/common/redhat/rhel-9.6-{{ grains['osarch'] }}
enabled=1
priority=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/PGDG-RPM-GPG-KEY-RHEL

